# Vyapari FastAPI Backend — Environment Variables
# Copy this to .env and fill in your values

# ── MySQL Database ──────────────────────────────────────────
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vyapari

# ── JWT Auth ────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=vyapari-change-this-to-a-long-random-secret-in-production

# ── Frontend connection ─────────────────────────────────────
# Set in frontend/.env as: EXPO_PUBLIC_FASTAPI_URL=http://<YOUR_PC_LAN_IP>:8000
